# 国内构建：DaoCloud 推荐前缀 m.daocloud.io/docker.io/...
# 若仍 502，请用：./deploy/scripts/server-update.sh --official
# 构建上下文：仓库根目录
ARG NODE_IMAGE=m.daocloud.io/docker.io/library/node:16-bullseye
ARG NGINX_IMAGE=m.daocloud.io/docker.io/library/nginx:1.25-alpine

FROM ${NODE_IMAGE} AS builder
WORKDIR /src
COPY admin/package.json admin/package-lock.json* ./
RUN npm install --registry=https://registry.npmmirror.com
COPY admin/ ./
# CI=false：避免 BuildKit 默认 CI=true 把 webpack 警告当错误
# 空 BASE_API → 运行时用 location.origin
ENV CI=false \
    VUE_APP_BASE_API= \
    NODE_OPTIONS=--max-old-space-size=3072
RUN npm run build:prod

FROM ${NGINX_IMAGE}
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
COPY deploy/docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/dist /usr/share/nginx/html
EXPOSE 80
