# 国内构建：经 DaoCloud 代理拉 temurin（避免直连 docker.io 超时）
FROM docker.m.daocloud.io/library/eclipse-temurin:8-jre-jammy

WORKDIR /app
RUN mkdir -p /data/qianxu /app/logs \
 && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
 && echo "Asia/Shanghai" > /etc/timezone

COPY qianxu/qianxu-admin/target/Qianxu-admin.jar /app/app.jar

ENV JAVA_OPTS="-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 -Xms512m -Xmx1024m" \
    TZ=Asia/Shanghai \
    SERVER_PORT=8080

EXPOSE 8080
VOLUME ["/data/qianxu", "/app/logs"]

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar --server.port=${SERVER_PORT}"]
