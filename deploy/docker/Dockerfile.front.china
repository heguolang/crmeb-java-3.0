# 国内构建：DaoCloud 推荐前缀（旧 docker.m.daocloud.io/library 偶发 502）
# 若仍失败：./deploy/scripts/server-update.sh --official
FROM m.daocloud.io/docker.io/library/eclipse-temurin:8-jre-jammy

WORKDIR /app
RUN mkdir -p /data/qianxu /app/logs \
 && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
 && echo "Asia/Shanghai" > /etc/timezone

COPY qianxu/qianxu-front/target/Qianxu-front.jar /app/app.jar

ENV JAVA_OPTS="-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 -Xms512m -Xmx1024m" \
    TZ=Asia/Shanghai \
    SERVER_PORT=8081

EXPOSE 8081
VOLUME ["/data/qianxu", "/app/logs"]

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar --server.port=${SERVER_PORT}"]
