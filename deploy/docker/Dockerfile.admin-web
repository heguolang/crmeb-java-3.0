# 后台 Vue 静态资源（同域 /api 走 Nginx 反代，避免写死域名）
# 构建上下文：仓库根目录
FROM node:16-bullseye AS builder
WORKDIR /src
COPY admin/package.json admin/package-lock.json* ./
RUN npm install --registry=https://registry.npmmirror.com
COPY admin/ ./
# 空 BASE_API → 运行时用 location.origin；legacy 放命令行（不可进 NODE_OPTIONS）
ENV VUE_APP_BASE_API=
RUN node --openssl-legacy-provider ./node_modules/@vue/cli-service/bin/vue-cli-service.js build

FROM nginx:1.25-alpine
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
COPY deploy/docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/dist /usr/share/nginx/html
EXPOSE 80
