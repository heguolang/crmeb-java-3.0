# ============================================================
# 一客户一套：复制为 .env 后修改
#   cp .env.example .env
# ============================================================

# --- 客户标识（容器名前缀，英文短码）---
COMPOSE_PROJECT_NAME=qianxu_demo

# --- 镜像版本（与 build-images 的 TAG 一致）---
IMAGE_TAG=3.0.0

# --- 对外只开 Web（MySQL/Redis 默认不映射公网）---
HTTP_PORT=80

# --- 容器内 MySQL（应用通过服务名 mysql 访问）---
MYSQL_ROOT_PASSWORD=ChangeMe_Root_Pass
MYSQL_DATABASE=qianxu
MYSQL_USER=qianxu
MYSQL_PASSWORD=ChangeMe_Db_Pass

# --- 容器内 Redis ---
REDIS_PASSWORD=ChangeMe_Redis_Pass
REDIS_DB_ADMIN=10
REDIS_DB_FRONT=11
REDIS_DB_ADMIN_SECOND=14
REDIS_DB_FRONT_SECOND=13

# --- 仅当使用 docker-compose.ports.yml 时才需要 ---
# MYSQL_PORT=127.0.0.1:3306
# REDIS_PORT=127.0.0.1:6379

# --- 外置数据库/Redis（可选；不填则用上面 compose 内的 mysql/redis）---
# SPRING_DATASOURCE_URL=jdbc:mysql://你的RDS地址:3306/qianxu?characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=qianxu
# SPRING_DATASOURCE_PASSWORD=你的库密码
# SPRING_REDIS_HOST=你的Redis地址
# SPRING_REDIS_PORT=6379
# SPRING_REDIS_PASSWORD=你的Redis密码

# --- JVM（请保留引号）---
JAVA_OPTS_ADMIN="-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 -Xms512m -Xmx1024m"
JAVA_OPTS_FRONT="-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 -Xms512m -Xmx1024m"

# --- 业务 ---
QIANXU_IMAGE_PATH=/data/qianxu/
QIANXU_DEMO_SITE=false
